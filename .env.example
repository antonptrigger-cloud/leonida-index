# Community map (see docs/COMMUNITY_MAP.md). Copy to .env.local for local dev.
# Without the Supabase values the site still builds and /map shows the official
# seed pins read-only. In `npm run dev` an in-memory store is used instead.

# Supabase project URL (Project Settings -> API). Either name works.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Secret / service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Moderator password for /map/admin.
MOD_PASSWORD=
# Random string (32+ chars) used to sign the moderator session cookie and salt IP hashes.
# Generate one with: openssl rand -hex 32
MOD_SESSION_SECRET=
# Optional: separate bearer token for a moderation bot. Falls back to MOD_PASSWORD.
MOD_API_TOKEN=

# Optional (dev only): set to "off" to disable the in-memory store in `npm run dev`.
# MAP_STORE=off

# Optional: Google Search Console HTML-tag verification (URL-prefix property).
# Paste only the content="..." value from Google's meta tag. Not needed if you verify via DNS TXT.
GOOGLE_SITE_VERIFICATION=
